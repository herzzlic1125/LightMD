@@ -489,13 +507,17 @@ static int scan_delims(cmark_parser *parser, subject *subj, unsigned char c,
                 (!right_flanking || cmark_utf8proc_is_punctuation(before_char));
     *can_close = right_flanking &&
                  (!left_flanking || cmark_utf8proc_is_punctuation(after_char));
+    *can_open = *can_open || is_cjk_emphasis_punctuation(after_char);
+    *can_close = *can_close || is_cjk_emphasis_punctuation(before_char);
   } else if (c == '\'' || c == '"') {
     *can_open = left_flanking && !right_flanking &&
 	         before_char != ']' && before_char != ')';
     *can_close = right_flanking;
   } else {
-    *can_open = left_flanking;
-    *can_close = right_flanking;
+    *can_open = left_flanking ||
+                (c == '*' && is_cjk_emphasis_punctuation(after_char));
+    *can_close = right_flanking ||
+                 (c == '*' && is_cjk_emphasis_punctuation(before_char));
   }
   return numdelims;
 }
@@ -1954,6 +1976,11 @@ int cmark_inline_parser_scan_delimiters(cmark_inline_parser *parser,
   *right_flanking = numdelims > 0 && !cmark_utf8proc_is_space(before_char) &&
